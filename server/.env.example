# Required
MONGODB_URI=
JWT_SECRET=
# Production: the exact frontend address(es), https, no trailing slash. Several can be comma-separated.
CLIENT_URL=http://localhost:5173
# Production: NODE_ENV=production (turns on Secure + SameSite=None cookies)
NODE_ENV=
# Hosting providers set PORT themselves
PORT=5000
# Day boundaries for "today" on dashboards (hosts run in UTC by default)
TZ=Asia/Kolkata
# Number of proxies in front of the app (Render = 1)
TRUST_PROXY=1
# Termux only, if mongodb+srv fails with querySrv ECONNREFUSED:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Password reset email. EMAIL_PROVIDER: resend | smtp | console (development only, prints the code in the server terminal) | none
EMAIL_PROVIDER=none
EMAIL_FROM=HostelHub <no-reply@your-domain>
# resend (HTTPS API, recommended on Render free where SMTP ports are blocked)
RESEND_API_KEY=
# smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
